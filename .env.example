# Copy to .env and fill in. NEVER commit .env.

# --- App ---
# Must be a long random value outside development (the app refuses to start otherwise).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://documind:documind@db:5432/documind

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Vector store (Qdrant) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documind_chunks

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# --- Retrieval ---
# Minimum cosine similarity for a chunk to count as relevant. Below it, the question
# is answered by general AI without document sources. Tune with eval/evaluate_rag.py.
RETRIEVAL_MIN_SCORE=0.55

# --- Rate limits (requests per minute, per user) ---
RATE_LIMIT_DEFAULT_RPM=60
RATE_LIMIT_QUERY_RPM=30
RATE_LIMIT_UPLOAD_RPM=10
RATE_LIMIT_SUGGESTIONS_RPM=5
